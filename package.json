{
  "name": "a-testers",
  "version": "0.1.0",
  "private": true,
  "description": "Community-driven Google Play closed-testing exchange",
  "workspaces": ["packages/*", "functions", "web"],
  "scripts": {
    "build:shared": "npm run build --workspace @a-testers/shared",
    "build:functions": "npm run build --workspace functions",
    "build": "npm run build:shared && npm run build:functions",
    "test": "npm run test --workspace @a-testers/shared && npm run test --workspace functions",
    "emulators": "firebase emulators:start",
    "dev:web": "npm run dev --workspace web"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
